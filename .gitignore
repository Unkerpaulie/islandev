# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Django ---
db.sqlite3
db.sqlite3-journal
local_settings.py

# --- Virtualenvs ---
.venv/
venv/
env/

# --- Static / media (runtime artifacts, live in <islandev_root>/) ---
# Note: these dirs live OUTSIDE the repo. Listed here as a safety net only.
/staticfiles/
/media/

# --- Tailwind ---
# The compiled CSS (site.css) IS committed. It is the build artifact for
# deployment — there is no server-side build step, so the repo must carry it.
# Rebuild locally with the v3 standalone CLI before committing template changes
# that introduce new Tailwind classes:
#   ./tailwindcss -o static/css/site.css --minify
#
# The standalone binary itself is NOT committed (it's platform-specific).
tailwindcss
tailwindcss.exe
tailwindreload.bat

# --- Secrets ---
# .env lives at <islandev_root>/.env, outside the repo. Safety net only.
.env
.env.local

# --- IDE / OS ---
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# --- Test / coverage ---
.coverage
htmlcov/
.pytest_cache/
