# =============================================================================
# Islan.DEV Environment Configuration
# =============================================================================
# Authoritative reference for every variable the application and deploy
# scripts read. Copy this file to <islandev_root>/.env and fill in values.
#
# Location on server: /var/www/islandev_root/.env
# NEVER commit the populated .env — only this example file belongs in git.
# =============================================================================

# ── Django Settings Module ──────────────────────────────────────────────────
# Dev:  islandev.settings.dev
# Prod: islandev.settings.prod
DJANGO_SETTINGS_MODULE=islandev.settings.prod

# ── Environment Label ───────────────────────────────────────────────────────
# Human-readable label used by deploy scripts for conditional logic.
DJANGO_ENV=production

# ── Django Core ─────────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-me-with-a-long-random-string

DEBUG=False

# Comma-separated, no spaces. Include both apex and www in production.
ALLOWED_HOSTS=islan.dev,www.islan.dev

# ── Database ─────────────────────────────────────────────────────────────────
# Format: postgres://user:password@host:port/dbname
# build.sh parses this to create the database and user automatically.
DATABASE_URL=postgres://islandev_user:your-db-password@localhost:5432/islandev

# ── Security Flags ───────────────────────────────────────────────────────────
# All True in production. Set to False locally in your dev .env.
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=2592000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# ── Email (Resend) ───────────────────────────────────────────────────────────
# Obtain at https://resend.com/api-keys — must be a verified sending domain.
# Leave blank in dev to disable email sending without raising errors.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# "From" address for outgoing notifications. Domain must be verified in Resend.
RESEND_FROM_EMAIL=Islan.DEV <hello@islan.dev>

# Where contact form and booking notifications are delivered (your inbox).
CONTACT_NOTIFICATION_EMAIL=hello@islan.dev

# ── Infrastructure ───────────────────────────────────────────────────────────
# Systemd service name — used by build.sh and redeploy.sh for start/restart.
GUNICORN_SERVICE_NAME=islandev

# Virtual environment path, relative to islandev_root/.
VENV_PATH=.venv

# Gunicorn bind port. 8000 is the default; change if running multiple projects.
GUNICORN_PORT=8000

# Number of Gunicorn worker processes. Rule of thumb: (2 × CPU cores) + 1.
# For a 1-vCPU droplet, 3 is appropriate.
GUNICORN_WORKERS=3

# Primary domain (without www). Used by build.sh to write the Nginx config.
# Nginx will serve both <SERVER_NAME> and www.<SERVER_NAME>.
SERVER_NAME=islan.dev
